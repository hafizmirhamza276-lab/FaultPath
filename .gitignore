# ground truth, never the document it came from. See CLAUDE.md.
# ---------------------------------------------------------------------------
*.pdf
*-decrypted.pdf
*_decrypted.pdf

# ---------------------------------------------------------------------------
# Generated evaluation output -- reproducible, not source of record
# ---------------------------------------------------------------------------
eval_out/
runs/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Local environment / editor
# ---------------------------------------------------------------------------
.env
.env.*
.DS_Store
.idea/
.vscode/

# ---------------------------------------------------------------------------
# NOT ignored, deliberately:
#   golden/          the ground truth -- the whole point of this repo
#   reports/         audit baseline, tracked so regressions are visible in diff
# ---------------------------------------------------------------------------

# Transcription kit page images: 22MB of rendered Komatsu pages. The
# templates and manifest are tracked; the PNGs are regenerable from the
# PDF and are copyrighted source material.
reports/transcription/**/*.png

# Crop images: rendered Komatsu page regions, regenerable from the PDF.
reports/transcription/crops/*.png

# session-hook artefacts, not project data
.ai/

# Meeting media and transcripts. Not project data, and not this repo's to hold:
# the .mp4 alone is ~168 MB and sits in the repo root, one `git add -A` from
# being permanent in history. The files are deliberately NOT deleted -- they
# belong to whoever put them here. This only makes them un-addable.
#
# Not hypothetical: PROJECT_STATE.md entered the repo in 102600a exactly this
# way, swept in by a blanket add on an unrelated commit.
*.mp4
*.mp3
meeting_notes.md
meeting_transcript.*
transcribe_meeting.py
